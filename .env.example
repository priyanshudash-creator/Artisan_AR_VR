# SHILPA AI CRAFT GUIDE — Environment Configuration
# Copy this file to .env and fill in your Groq API credentials.
# NEVER commit your real .env file or API key to version control!

# Groq API Key (Obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Identifier
# Supported chat models on Groq:
# - openai/gpt-oss-120b (Recommended: 120B high-capacity reasoning model)
# - openai/gpt-oss-20b (Ultra-fast, responsive)
# - qwen/qwen3.8-27b (Strong multilinguality)
# - llama-3.3-70b-versatile (Meta Llama on standard tier)
GROQ_MODEL=openai/gpt-oss-120b

# Standalone Express Server Port (Optional, defaults to 3001)
PORT=3001
